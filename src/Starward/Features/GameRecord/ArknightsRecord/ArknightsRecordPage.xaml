<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Starward.Features.GameRecord.ArknightsRecord.ArknightsRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Starward.Features.GameRecord.ArknightsRecord"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="RecordItemTemplate" x:DataType="local:ArknightsRecordItemView">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{x:Bind Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Subtitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="4"
                                     Margin="0,6,0,0"
                                     Maximum="{x:Bind ProgressMaximum}"
                                     Value="{x:Bind ProgressValue}"
                                     Visibility="{x:Bind HasProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind Value}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="24,16,24,24" Spacing="16">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="明日方舟战绩" />
                <ProgressRing x:Name="ProgressRing_Loading"
                              Width="32"
                              Height="32"
                              HorizontalAlignment="Left"
                              IsActive="True" />
                <TextBlock x:Name="TextBlock_Error"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="Panel_Content" Spacing="16" Visibility="Collapsed">
                    <Border Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="Image_Avatar"
                                   Width="56"
                                   Height="56"
                                   VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="TextBlock_RoleName"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="TextBlock_RoleInfo"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Pivot x:Name="Pivot_Records">
                        <PivotItem Header="卫戍协议">
                            <ItemsControl x:Name="Items_Garrison" ItemTemplate="{StaticResource RecordItemTemplate}" />
                        </PivotItem>
                        <PivotItem Header="SideStory">
                            <ItemsControl x:Name="Items_Activities" ItemTemplate="{StaticResource RecordItemTemplate}" />
                        </PivotItem>
                        <PivotItem Header="集成战略">
                            <ItemsControl x:Name="Items_Rogues" ItemTemplate="{StaticResource RecordItemTemplate}" />
                        </PivotItem>
                        <PivotItem Header="生息演算">
                            <ItemsControl x:Name="Items_Sandboxes" ItemTemplate="{StaticResource RecordItemTemplate}" />
                        </PivotItem>
                        <PivotItem Header="保全派驻">
                            <ItemsControl x:Name="Items_Towers" ItemTemplate="{StaticResource RecordItemTemplate}" />
                        </PivotItem>
                        <PivotItem Header="剿灭作战">
                            <ItemsControl x:Name="Items_Campaigns" ItemTemplate="{StaticResource RecordItemTemplate}" />
                        </PivotItem>
                        <PivotItem Header="引航者试炼">
                            <ItemsControl x:Name="Items_BossRushes" ItemTemplate="{StaticResource RecordItemTemplate}" />
                        </PivotItem>
                    </Pivot>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
