<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Starward.Features.GameRecord.ArknightsRecord.ArknightsRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Starward.Features.GameRecord.ArknightsRecord"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="RecordItemTemplate" x:DataType="local:ArknightsRecordItemView">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{x:Bind Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Subtitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="4"
                                     Margin="0,6,0,0"
                                     Maximum="{x:Bind ProgressMaximum}"
                                     Value="{x:Bind ProgressValue}"
                                     Visibility="{x:Bind HasProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind Value}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <NavigationView x:Name="NavigationView_Records"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        ItemInvoked="NavigationView_Records_ItemInvoked"
                        OpenPaneLength="248"
                        PaneDisplayMode="Left">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <Grid Height="56"
                      HorizontalAlignment="Stretch"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="56"
                            Height="56"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="100">
                        <Image x:Name="Image_Avatar" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock x:Name="TextBlock_RoleName" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TextBlock_RoleInfo"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button x:Name="Button_LoginArknights"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,12,0"
                            BorderThickness="0"
                            Click="Button_LoginArknights_Click"
                            Content="登录"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="Collapsed" />

                    <Button x:Name="Button_AccountList"
                            Grid.Column="2"
                            Width="28"
                            Height="44"
                            Margin="0,0,12,0"
                            Padding="0"
                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                            Visibility="Collapsed">
                        <StackPanel Spacing="-6">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE70E;" />
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE70D;" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{ThemeResource CustomAcrylicBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="4" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel MinWidth="240"
                                            Padding="4"
                                            Spacing="4">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="Button_Refresh_Click"
                                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                            <TextBlock VerticalAlignment="Center" Text="刷新信息" />
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="Button_LoginArknights_Click"
                                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                                            <TextBlock VerticalAlignment="Center" Text="登录鹰角账号" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="NavigationViewItem_Garrison" Tag="garrison" Content="卫戍协议">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Image/icon_arknights_garrison.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="rogue" Content="集成战略">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Image/icon_arknights_rogue.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="activity" Content="活动战绩">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Image/icon_arknights_activity.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="h5" Content="战绩">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Image/ced4deac2162690105bbc8baad2b51a3_4109616186965788891.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <NavigationViewItem x:Name="NavigationViewItem_UpdateDeviceInfo"
                                    Margin="-2,0,0,-4"
                                    Content="更新设备指纹"
                                    Tapped="NavigationViewItem_UpdateDeviceInfo_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE928;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.PaneFooter>

            <Grid>
                <ScrollViewer>
                    <StackPanel Padding="24,16,24,24" Spacing="12">
                        <ProgressRing x:Name="ProgressRing_Loading"
                                      Width="32"
                                      Height="32"
                                      HorizontalAlignment="Left"
                                      IsActive="True" />
                        <TextBlock x:Name="TextBlock_Error"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" />
                        <ItemsControl x:Name="Items_Records" ItemTemplate="{StaticResource RecordItemTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
