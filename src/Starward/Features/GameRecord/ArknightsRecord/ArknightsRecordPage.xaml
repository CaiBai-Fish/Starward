<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Starward.Features.GameRecord.ArknightsRecord.ArknightsRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="24,16,24,24" Spacing="16">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="明日方舟战绩" />
                <ProgressRing x:Name="ProgressRing_Loading"
                              Width="32"
                              Height="32"
                              HorizontalAlignment="Left"
                              IsActive="True" />
                <TextBlock x:Name="TextBlock_Error"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="Panel_Content" Spacing="16" Visibility="Collapsed">
                    <Border Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="TextBlock_RoleName" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="TextBlock_RoleInfo"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="卫戍协议" />
                            <TextBlock x:Name="TextBlock_Garrison"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl x:Name="ItemsControl_Garrison">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2"
                                                   FontSize="13"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="活动战绩" />
                            <ItemsControl x:Name="ItemsControl_Activities">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2"
                                                   FontSize="13"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="剿灭作战" />
                            <ItemsControl x:Name="ItemsControl_Campaigns">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2"
                                                   FontSize="13"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="保全派驻" />
                            <ItemsControl x:Name="ItemsControl_Towers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2"
                                                   FontSize="13"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="集成战略" />
                            <ItemsControl x:Name="ItemsControl_Rogues">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2"
                                                   FontSize="13"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
