<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.GameRecord.EndfieldToolbox.UmbralMonumentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.GameRecord.EndfieldToolbox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prim="using:Microsoft.UI.Xaml.Controls.Primitives"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="MonumentStageTemplate" x:DataType="local:MonumentStageView">
            <Expander Margin="0,0,0,10"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="False">
                <Expander.Header>
                    <Grid ColumnSpacing="16" MinHeight="76">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16"
                                          Foreground="{ThemeResource EndfieldGoldBrush}"
                                          Glyph="&#xE73E;"
                                          Visibility="{x:Bind IsPass, Converter={StaticResource EndfieldBoolToVisibility}}" />
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Padding="7,1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource EndfieldGoldSoftBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsHard, Converter={StaticResource EndfieldBoolToVisibility}}">
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource EndfieldGoldBrush}"
                                               Text="苦难" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="{x:Bind TimestampText}" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="机制特性 / 敌方情报" />
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="{x:Bind RecommendLevelText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="16">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EndfieldGoldBrush}"
                                       Text="{x:Bind DurationText}" />
                            <ItemsControl ItemTemplate="{StaticResource EndfieldCharTileTemplate}"
                                          ItemsSource="{x:Bind Chars}"
                                          Visibility="{x:Bind HasChars, Converter={StaticResource EndfieldBoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind HasChars, Converter={StaticResource EndfieldBoolToVisibilityReversed}}">
                                <Border Width="48" Height="48" Background="{ThemeResource EndfieldEmptySlotBrush}" CornerRadius="8">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                                <Border Width="48" Height="48" Background="{ThemeResource EndfieldEmptySlotBrush}" CornerRadius="8">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                                <Border Width="48" Height="48" Background="{ThemeResource EndfieldEmptySlotBrush}" CornerRadius="8">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                                <Border Width="48" Height="48" Background="{ThemeResource EndfieldEmptySlotBrush}" CornerRadius="8">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <StackPanel Margin="0,12,0,4" Spacing="12">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource EndfieldGoldBrush}"
                               Text="机制特性" />
                    <TextBlock FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind FeatureText}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasFeature, Converter={StaticResource EndfieldBoolToVisibility}}" />
                    <TextBlock FontSize="13"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="暂无机制特性说明"
                               Visibility="{x:Bind HasFeature, Converter={StaticResource EndfieldBoolToVisibilityReversed}}" />

                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource EndfieldGoldBrush}"
                               Text="敌方情报" />
                    <ItemsControl ItemsSource="{x:Bind Enemies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:EndfieldEnemyView">
                                <Grid Margin="0,0,0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{ThemeResource EndfieldGoldSoftBrush}" CornerRadius="8">
                                        <Image Source="{x:Bind ImageUrl}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource EndfieldGoldBrush}"
                                                       Text="{x:Bind LevelText}" />
                                        </StackPanel>
                                        <TextBlock FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind Description}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="13"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="暂无敌人情报"
                               Visibility="{x:Bind HasEnemies, Converter={StaticResource EndfieldBoolToVisibilityReversed}}" />
                </StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Grid_Root">
        <ScrollViewer x:Name="ScrollViewer_Main"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Panel_Layout">
            <StackPanel Padding="24,20,24,40"
                        HorizontalAlignment="Stretch"
                        Spacing="16">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="影拓丰碑" />
                        <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="森空岛 · 终末地赛季战绩" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="Button_Refresh_Click"
                            Style="{StaticResource EndfieldGhostButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar x:Name="InfoBar_Message"
                         IsClosable="False"
                         IsOpen="False"
                         Severity="Informational" />

                <ProgressRing x:Name="ProgressRing_Loading"
                              Width="32"
                              Height="32"
                              HorizontalAlignment="Left"
                              IsActive="False"
                              Visibility="Collapsed" />

                <StackPanel x:Name="Panel_Content" Spacing="16" Visibility="Collapsed">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="Button_Activity1" Click="Activity_Click" Style="{StaticResource EndfieldTabButtonSelectedStyle}" Tag="0" />
                            <Button x:Name="Button_Activity2" Click="Activity_Click" Style="{StaticResource EndfieldTabButtonStyle}" Tag="1" />
                            <Button x:Name="Button_Activity3" Click="Activity_Click" Style="{StaticResource EndfieldTabButtonStyle}" Tag="2" />
                            <Button x:Name="Button_Activity4" Click="Activity_Click" Style="{StaticResource EndfieldTabButtonStyle}" Tag="3" />
                            <Button x:Name="Button_Activity5" Click="Activity_Click" Style="{StaticResource EndfieldTabButtonStyle}" Tag="4" />
                            <Button x:Name="Button_Activity6" Click="Activity_Click" Style="{StaticResource EndfieldTabButtonStyle}" Tag="5" />
                            <Button x:Name="Button_Activity7" Click="Activity_Click" Style="{StaticResource EndfieldTabButtonStyle}" Tag="6" />
                            <Button x:Name="Button_Activity8" Click="Activity_Click" Style="{StaticResource EndfieldTabButtonStyle}" Tag="7" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Style="{StaticResource EndfieldCardStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="136"
                                    Height="180"
                                    Background="{ThemeResource EndfieldAvatarPlaceholderBrush}"
                                    BorderBrush="{ThemeResource EndfieldStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Image Margin="1"
                                       Source="{x:Bind SelectedActivity.Pic}"
                                       Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                                <TextBlock FontSize="28"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind SelectedActivity.Name}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="{x:Bind SelectedActivity.DateRange}" />
                                    <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="{x:Bind SelectedActivity.StageCountText}" />
                                </StackPanel>

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="6" Background="{x:Bind SelectedActivity.ProgressSegments[0].Fill}" CornerRadius="3" />
                                    <Border Grid.Column="1" Height="6" Background="{x:Bind SelectedActivity.ProgressSegments[1].Fill}" CornerRadius="3" />
                                    <Border Grid.Column="2" Height="6" Background="{x:Bind SelectedActivity.ProgressSegments[2].Fill}" CornerRadius="3" />
                                    <Border Grid.Column="3" Height="6" Background="{x:Bind SelectedActivity.ProgressSegments[3].Fill}" CornerRadius="3" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource EndfieldGoldBrush}"
                                               Text="{x:Bind SelectedActivity.AchievementStateText}" />
                                    <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="{x:Bind SelectedActivity.ProgressText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="{x:Bind SelectedActivity.AchievementName}" />
                            </StackPanel>

                            <Grid Grid.Column="2"
                                  Width="104"
                                  Height="116"
                                  VerticalAlignment="Center">
                                <Polygon Fill="#1AFFFFFF"
                                         Points="52,0 104,26 104,90 52,116 0,90 0,26"
                                         Stroke="#66E7C567"
                                         StrokeThickness="1.4" />
                                <Image Width="64"
                                       Height="64"
                                       Source="{x:Bind SelectedActivity.AchievementIcon}"
                                       Stretch="Uniform" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Style="{StaticResource EndfieldSectionCaptionStyle}" Text="//" />
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="最佳通关记录" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ToggleSwitch_ShowHard"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      OffContent="仅普通"
                                      OnContent="含苦难"
                                      Toggled="ToggleSwitch_ShowHard_Toggled" />
                    </Grid>

                    <ItemsControl ItemTemplate="{StaticResource MonumentStageTemplate}" ItemsSource="{x:Bind Stages}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="该活动还没有通关记录。"
                               Visibility="{x:Bind HasStageRecords, Converter={StaticResource EndfieldBoolToVisibilityReversed}}" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</sf:PageBase>
