<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starward.Features.GameRecord.EndfieldToolbox"
    xmlns:scv="using:Starward.Converters">

    <scv:BoolToVisibilityConverter x:Key="EndfieldBoolToVisibility" />
    <scv:BoolToVisibilityReversedConverter x:Key="EndfieldBoolToVisibilityReversed" />


    <Style x:Key="EndfieldCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource EndfieldCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EndfieldStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="EndfieldStatCardStyle" TargetType="Border"
           BasedOn="{StaticResource EndfieldCardStyle}">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="EndfieldMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="EndfieldGhostButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource EndfieldCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EndfieldStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="EndfieldTabButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="EndfieldTabButtonSelectedStyle" TargetType="Button"
           BasedOn="{StaticResource EndfieldTabButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource EndfieldGoldBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EndfieldTextOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="EndfieldSectionCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource EndfieldGoldBrush}" />
    </Style>

    <DataTemplate x:Key="EndfieldCharCardTemplate">
        <Grid Width="150" Height="318" Margin="0,0,10,0">
            <Border Background="{ThemeResource EndfieldAvatarPlaceholderBrush}"
                    BorderBrush="{Binding AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="10">
                <Image Margin="1" Source="{Binding AvatarUrl}" Stretch="UniformToFill" />
            </Border>
            <Border Height="206" VerticalAlignment="Bottom" CornerRadius="0,0,10,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#000A0D12" />
                        <GradientStop Offset="0.3" Color="#B30A0D12" />
                        <GradientStop Offset="1" Color="#F20A0D12" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel Padding="10,0,10,10" VerticalAlignment="Bottom" Spacing="8">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Margin="0,0,0,3"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Foreground="#B3FFFFFF"
                                   Text="LV" />
                        <TextBlock FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="{Binding LevelNumberText}" />
                    </StackPanel>
                    <Border Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#660A0D12"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="15"
                            ToolTipService.ToolTip="{Binding PotentialText}"
                            Visibility="{Binding HasPotential, Converter={StaticResource EndfieldBoolToVisibility}}">
                        <Image Margin="2"
                               Source="{Binding PotentialIconSource}"
                               Stretch="Uniform" />
                    </Border>
                </Grid>
                <Grid ColumnSpacing="8" Visibility="{Binding HasWeapon, Converter={StaticResource EndfieldBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Width="30"
                            Height="30"
                            Background="{ThemeResource EndfieldEmptySlotBrush}"
                            CornerRadius="6">
                        <Image Source="{Binding WeaponIcon}" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock MaxLines="1"
                                   FontSize="10"
                                   Foreground="#E6FFFFFF"
                                   Text="{Binding WeaponName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="9"
                                   Foreground="#99FFFFFF"
                                   Text="{Binding WeaponLevelText}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="6" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                <Border Height="44" Background="{ThemeResource EndfieldEmptySlotBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" ToolTipService.ToolTip="{Binding EquipSlot1.Name}">
                    <Grid>
                        <Image Source="{Binding EquipSlot1.Icon}" Stretch="Uniform" Visibility="{Binding EquipSlot1.HasItem, Converter={StaticResource EndfieldBoolToVisibility}}" />
                        <FontIcon FontSize="12" Foreground="#4DFFFFFF" Glyph="&#xE710;" Visibility="{Binding EquipSlot1.HasItem, Converter={StaticResource EndfieldBoolToVisibilityReversed}}" />
                        <Border Margin="0,0,3,2"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#B30A0D12"
                                CornerRadius="3"
                                Visibility="{Binding EquipSlot1.HasItem, Converter={StaticResource EndfieldBoolToVisibility}}">
                            <TextBlock FontSize="9" Foreground="#E6FFFFFF" Text="{Binding EquipSlot1.LevelText}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Height="44" Background="{ThemeResource EndfieldEmptySlotBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" ToolTipService.ToolTip="{Binding EquipSlot2.Name}">
                    <Grid>
                        <Image Source="{Binding EquipSlot2.Icon}" Stretch="Uniform" Visibility="{Binding EquipSlot2.HasItem, Converter={StaticResource EndfieldBoolToVisibility}}" />
                        <FontIcon FontSize="12" Foreground="#4DFFFFFF" Glyph="&#xE710;" Visibility="{Binding EquipSlot2.HasItem, Converter={StaticResource EndfieldBoolToVisibilityReversed}}" />
                        <Border Margin="0,0,3,2"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#B30A0D12"
                                CornerRadius="3"
                                Visibility="{Binding EquipSlot2.HasItem, Converter={StaticResource EndfieldBoolToVisibility}}">
                            <TextBlock FontSize="9" Foreground="#E6FFFFFF" Text="{Binding EquipSlot2.LevelText}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Height="44" Background="{ThemeResource EndfieldEmptySlotBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" ToolTipService.ToolTip="{Binding EquipSlot3.Name}">
                    <Grid>
                        <Image Source="{Binding EquipSlot3.Icon}" Stretch="Uniform" Visibility="{Binding EquipSlot3.HasItem, Converter={StaticResource EndfieldBoolToVisibility}}" />
                        <FontIcon FontSize="12" Foreground="#4DFFFFFF" Glyph="&#xE710;" Visibility="{Binding EquipSlot3.HasItem, Converter={StaticResource EndfieldBoolToVisibilityReversed}}" />
                        <Border Margin="0,0,3,2"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#B30A0D12"
                                CornerRadius="3"
                                Visibility="{Binding EquipSlot3.HasItem, Converter={StaticResource EndfieldBoolToVisibility}}">
                            <TextBlock FontSize="9" Foreground="#E6FFFFFF" Text="{Binding EquipSlot3.LevelText}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Height="44" Background="{ThemeResource EndfieldEmptySlotBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" ToolTipService.ToolTip="{Binding EquipSlot4.Name}">
                    <Grid>
                        <Image Source="{Binding EquipSlot4.Icon}" Stretch="Uniform" Visibility="{Binding EquipSlot4.HasItem, Converter={StaticResource EndfieldBoolToVisibility}}" />
                        <FontIcon FontSize="12" Foreground="#4DFFFFFF" Glyph="&#xE710;" Visibility="{Binding EquipSlot4.HasItem, Converter={StaticResource EndfieldBoolToVisibilityReversed}}" />
                        <Border Margin="0,0,3,2"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#B30A0D12"
                                CornerRadius="3"
                                Visibility="{Binding EquipSlot4.HasItem, Converter={StaticResource EndfieldBoolToVisibility}}">
                            <TextBlock FontSize="9" Foreground="#E6FFFFFF" Text="{Binding EquipSlot4.LevelText}" />
                        </Border>
                    </Grid>
                </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="EndfieldCharTileTemplate">
        <StackPanel Width="72" Spacing="4" Margin="0,0,8,0">
            <Grid Width="72" Height="72">
                <Border Background="{ThemeResource EndfieldAvatarPlaceholderBrush}"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10">
                    <Image Margin="1"
                           Source="{Binding AvatarUrl}"
                           Stretch="UniformToFill" />
                </Border>
                <Border Margin="0,-6,-6,0"
                        Padding="5,1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{Binding AccentBrush}"
                        CornerRadius="6"
                        Visibility="{Binding HasRarity, Converter={StaticResource EndfieldBoolToVisibility}}">
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF171208"
                               Text="{Binding RarityText}" />
                </Border>
            </Grid>
            <TextBlock HorizontalAlignment="Center"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{Binding LevelText}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="EndfieldStatTemplate">
        <Border Style="{StaticResource EndfieldStatCardStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center"
                          FontSize="16"
                          Foreground="{ThemeResource EndfieldGoldBrush}"
                          Glyph="{Binding Glyph}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{Binding Label}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{Binding Value}" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
