<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameRecord.EndfieldToolbox.CrisisRecordDetailDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:Starward.Features.GameRecord.EndfieldToolbox"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               x:DefaultBindMode="OneTime"
               CloseButtonText="关闭"
               DefaultButton="Close"
               Title="挑战详情"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">660</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="630" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Foreground="{ThemeResource EndfieldGoldBrush}"
                           Text="{x:Bind Record.StatusText}" />
                <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="{x:Bind Record.TimestampText}" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource EndfieldStatCardStyle}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource EndfieldGoldBrush}"
                                       Text="{x:Bind Record.IndicatorCountText}" />
                            <TextBlock Margin="0,0,0,5"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource EndfieldMetaTextStyle}"
                                       Text="指标总计" />
                            <Border Padding="7,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource EndfieldGoldSoftBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind Record.ShowNewBadge, Converter={StaticResource EndfieldBoolToVisibility}}">
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource EndfieldGoldBrush}"
                                           Text="新纪录" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="本次挑战累计的合约指标分值" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource EndfieldStatCardStyle}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource EndfieldGoldBrush}"
                                       Text="{x:Bind Record.DurationText}" />
                            <TextBlock Margin="0,0,0,5"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource EndfieldMetaTextStyle}"
                                       Text="行动时长" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource EndfieldMetaTextStyle}" Text="{x:Bind Record.WaveText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl ItemTemplate="{StaticResource EndfieldCharCardTemplate}" ItemsSource="{x:Bind Chars}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Style="{StaticResource EndfieldSectionCaptionStyle}" Text="//" />
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="指标一览" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource EndfieldMetaTextStyle}"
                           Text="{x:Bind IndicatorCaption}" />
            </StackPanel>

            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{x:Bind StatusText}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind HasStatusText, Converter={StaticResource EndfieldBoolToVisibility}}" />

            <ItemsRepeater ItemsSource="{x:Bind Indicators}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout ItemsStretch="Fill"
                                       MinColumnSpacing="8"
                                       MinItemWidth="76"
                                       MinRowSpacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:CrisisContractIndicatorView">
                        <Border Width="68"
                                Height="68"
                                Background="{ThemeResource EndfieldEmptySlotBrush}"
                                BorderBrush="{ThemeResource EndfieldStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ToolTipService.ToolTip="{x:Bind Name}">
                            <Grid>
                                <Image Margin="6" Source="{x:Bind Icon}" Stretch="Uniform" />
                                <Border Margin="0,0,4,4"
                                        Padding="4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="#B30A0D12"
                                        CornerRadius="4">
                                    <TextBlock FontSize="10"
                                               Foreground="{ThemeResource EndfieldGoldBrush}"
                                               Text="{x:Bind ScoreText}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{x:Bind StatusText}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
