<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.GameLauncher.HypergryphGameNoticeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.GameLauncher"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             mc:Ignorable="d">

    <Grid Loaded="Grid_Loaded">
        <WebView2 x:Name="WebView_Notice"
                  DefaultBackgroundColor="Transparent"
                  Visibility="Collapsed" />

        <Border x:Name="Border_Loading"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#60000000"
                CornerRadius="8">
            <ProgressRing x:Name="ProgressRing_Loading"
                          Width="60"
                          Height="60"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          IsActive="True" />
        </Border>

        <TextBlock x:Name="TextBlock_Empty"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="公告加载失败"
                   Visibility="Collapsed" />
    </Grid>
</sf:WindowEx>
