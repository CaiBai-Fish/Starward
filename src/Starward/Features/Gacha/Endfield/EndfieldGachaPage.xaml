<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.Gacha.Endfield.EndfieldGachaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.Gacha.Endfield"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
            <Image Width="28"
                   Height="28"
                   Source="ms-appx:///Assets/Image/icon_endfield.png" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="终末地" />
        </StackPanel>

        <StackPanel Margin="0,0,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
            <ComboBox Width="190"
                      IsEnabled="{x:Bind IsSyncing, Converter={StaticResource BoolReversedConverter}}"
                      ItemsSource="{x:Bind Accounts}"
                      PlaceholderText="选择账号"
                      SelectedItem="{x:Bind SelectedAccount, Mode=TwoWay}" />
            <SplitButton Command="{x:Bind SyncGachaCommand}"
                         IsEnabled="{x:Bind IsSyncing, Converter={StaticResource BoolReversedConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="同步记录" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Command="{x:Bind LoginAccountCommand}"
                                        Icon="Contact"
                                        Text="登录鹰角账号" />
                        <MenuFlyoutItem Command="{x:Bind InputLoginTokenCommand}"
                                        Icon="Permissions"
                                        Text="输入登录 Token" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Command="{x:Bind SyncFromGameLogCommand}"
                                        Icon="OpenFile"
                                        Text="从游戏日志同步" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Button Command="{x:Bind CancelSyncCommand}"
                    Content="取消"
                    Visibility="{x:Bind IsSyncing}" />
            <ProgressRing Width="18"
                          Height="18"
                          IsActive="{x:Bind IsSyncing}" />
        </StackPanel>

        <InfoBar Grid.Row="1"
                 Margin="20,4,20,10"
                 IsClosable="True"
                 IsOpen="{x:Bind IsStatusOpen, Mode=TwoWay}"
                 Message="{x:Bind StatusText}"
                 Severity="{x:Bind StatusSeverity}" />

        <Grid Grid.Row="2"
              Margin="20,0,20,16"
              ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  角色寻访  -->
            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="角色寻访" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind CharacterSummaryText}" />
                </Grid>
                <Border Grid.Row="1"
                        Padding="14,8"
                        Background="{ThemeResource CustomOverlayAcrylicBrush}"
                        CornerRadius="8"
                        Visibility="{x:Bind CharacterColumnStats.HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="6★ 平均" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#3BA272"
                                       Text="{x:Bind CharacterColumnStats.Average6Text}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="6★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FFA500">
                                <Run Text="{x:Bind CharacterColumnStats.Count6}" />
                                <Run Text="[" /><Run Text="{x:Bind CharacterColumnStats.Ratio6Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="5★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#C864E0">
                                <Run Text="{x:Bind CharacterColumnStats.Count5}" />
                                <Run Text="[" /><Run Text="{x:Bind CharacterColumnStats.Ratio5Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="4★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#5EAAED">
                                <Run Text="{x:Bind CharacterColumnStats.Count4}" />
                                <Run Text="[" /><Run Text="{x:Bind CharacterColumnStats.Ratio4Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto">
                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind CharacterStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:EndfieldGachaPoolStats">
                                <local:EndfieldGachaStatsCard Margin="0,0,0,12" PoolStats="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2"
                            Margin="0,60,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Spacing="8"
                            Visibility="{x:Bind IsCharacterEmpty}">
                    <FontIcon FontSize="30" Glyph="&#xF4A5;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="暂无记录" />
                </StackPanel>
            </Grid>

            <!--  武器申领  -->
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="武器申领" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind WeaponSummaryText}" />
                </Grid>
                <Border Grid.Row="1"
                        Padding="14,8"
                        Background="{ThemeResource CustomOverlayAcrylicBrush}"
                        CornerRadius="8"
                        Visibility="{x:Bind WeaponColumnStats.HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="6★ 平均" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#3BA272"
                                       Text="{x:Bind WeaponColumnStats.Average6Text}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="6★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FFA500">
                                <Run Text="{x:Bind WeaponColumnStats.Count6}" />
                                <Run Text="[" /><Run Text="{x:Bind WeaponColumnStats.Ratio6Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="5★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#C864E0">
                                <Run Text="{x:Bind WeaponColumnStats.Count5}" />
                                <Run Text="[" /><Run Text="{x:Bind WeaponColumnStats.Ratio5Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="4★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#5EAAED">
                                <Run Text="{x:Bind WeaponColumnStats.Count4}" />
                                <Run Text="[" /><Run Text="{x:Bind WeaponColumnStats.Ratio4Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto">
                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind WeaponStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:EndfieldGachaPoolStats">
                                <local:EndfieldGachaStatsCard Margin="0,0,0,12" PoolStats="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2"
                            Margin="0,60,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Spacing="8"
                            Visibility="{x:Bind IsWeaponEmpty}">
                    <FontIcon FontSize="30" Glyph="&#xF4A5;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="暂无记录" />
                </StackPanel>
            </Grid>

            <!--  基础寻访 / 复刻  -->
            <Grid Grid.Column="2" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind BasicColumnTitle}" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind BasicSummaryText}" />
                </Grid>
                <Border Grid.Row="1"
                        Padding="14,8"
                        Background="{ThemeResource CustomOverlayAcrylicBrush}"
                        CornerRadius="8"
                        Visibility="{x:Bind BasicColumnStats.HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="6★ 平均" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#3BA272"
                                       Text="{x:Bind BasicColumnStats.Average6Text}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="6★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FFA500">
                                <Run Text="{x:Bind BasicColumnStats.Count6}" />
                                <Run Text="[" /><Run Text="{x:Bind BasicColumnStats.Ratio6Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="5★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#C864E0">
                                <Run Text="{x:Bind BasicColumnStats.Count5}" />
                                <Run Text="[" /><Run Text="{x:Bind BasicColumnStats.Ratio5Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="4★ 统计" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#5EAAED">
                                <Run Text="{x:Bind BasicColumnStats.Count4}" />
                                <Run Text="[" /><Run Text="{x:Bind BasicColumnStats.Ratio4Text}" /><Run Text="]" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto">
                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind BasicStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:EndfieldGachaPoolStats">
                                <local:EndfieldGachaStatsCard Margin="0,0,0,12" PoolStats="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2"
                            Margin="0,60,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Spacing="8"
                            Visibility="{x:Bind IsBasicEmpty}">
                    <FontIcon FontSize="30" Glyph="&#xF4A5;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="暂无记录" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</sf:PageBase>
